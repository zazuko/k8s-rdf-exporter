{
  "name": "@zazuko/k8s-rdf-exporter",
  "version": "0.4.1",
  "description": "Kubernetes RDF exporter",
  "main": "dist/index.js",
  "bin": "./dist/cli.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazuko/k8s-rdf-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/zazuko/k8s-rdf-exporter/issues"
  },
  "scripts": {
    "build": "tsc -p . && chmod +x ./dist/cli.js",
    "start": "npm run build && node ./dist/cli.js",
    "lint": "oxlint",
    "typecheck": "tsc -p . --noEmit && tsc -p ./test",
    "test": "npm run lint && npm run typecheck",
    "pretest:integration": "npm run build",
    "test:integration": "node --test test/integration.test.ts",
    "prepublish": "npm run build",
    "prepack": "npm run build",
    "release": "changeset publish"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kubernetes",
    "rdf",
    "exporter",
    "cli"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/clownface": "^2.0.10",
    "@types/node": "^24.13.3",
    "@zazuko/env-node": "^3.1.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@rdfjs/namespace": "^2.0.1",
    "@rdfjs/types": "^2.0.1",
    "@tpluscode/rdf-string": "^1.3.4",
    "@zazuko/env": "^3.0.1",
    "clownface": "^2.0.3",
    "commander": "^15.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
